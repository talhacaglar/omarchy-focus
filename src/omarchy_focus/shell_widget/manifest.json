{
  "schemaVersion": 1,
  "id": "omarchy-focus",
  "name": "Omarchy Focus",
  "version": "0.3.0",
  "author": "Talha Caglar",
  "license": "MIT",
  "description": "Pomodoro timer, tasks, site blocker and focus stats, all in one bar panel. Needs the omarchy-focus CLI 0.3+ (AUR).",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarchy Focus",
    "description": "Live countdown with a panel for the timer, tasks, the site guard, stats and settings.",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "showIdleCount": true,
      "refreshIntervalSec": 30
    },
    "schema": [
      {
        "key": "showIdleCount",
        "type": "boolean",
        "label": "Show open task count when idle",
        "defaultValue": true
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Background refresh (seconds)",
        "min": 10,
        "max": 600,
        "step": 5,
        "defaultValue": 30
      }
    ]
  },
  "homepage": "https://github.com/talhacaglar/omarchy-focus"
}
