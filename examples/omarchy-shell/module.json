{
  "id": "omarchy-focus-command",
  "type": "command",
  "exec": "~/.local/bin/omarchy-focus-bar status",
  "interval": 2,
  "tooltip": "Omarchy Focus",
  "onClick": "~/.local/bin/omarchy-focus-bar open",
  "onRightClick": "~/.local/bin/omarchy-focus-bar toggle-pomodoro",
  "onMiddleClick": "~/.local/bin/omarchy-focus-bar toggle-focus"
}
